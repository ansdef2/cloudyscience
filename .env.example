# ---- Database ----
DB_NAME=cloudco
DB_USER=postgres
DB_PASSWORD=postgres

# ---- Backend ----
NODE_ENV=production
JWT_SECRET=cloudco-secret-key-change-in-production
JWT_EXPIRES_IN=7d
# Разрешённый Origin для CORS; * — разрешить всем
CORS_ORIGIN=https://cloudco.senip.fun
# true пересоздаёт схему и заливает демо-данные при старте — существующая БД стирается
SEED_ON_START=false

# ---- Frontend ----
# Подставляется в бандл Next.js на этапе сборки образа
NEXT_PUBLIC_API_URL=https://cloudco.senip.fun/api
