# API Configuration
# URL бэкенд API (из репозитория https://github.com/ansdef/cloudco)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Для продакшена укажите реальный URL
# NEXT_PUBLIC_API_URL=https://api.cloudco.ru/api

# Карта на /home: векторные тайлы OpenFreeMap, ключ не нужен.
# Переопределить, только если поднят свой тайл-сервер (схема OpenMapTiles)
# NEXT_PUBLIC_MAP_TILES_URL=https://tiles.example.ru/planet
# NEXT_PUBLIC_MAP_GLYPHS_URL=https://tiles.example.ru/fonts/{fontstack}/{range}.pbf
YANDEX_MAP_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# S3 Storage (опционально)
# NEXT_PUBLIC_S3_BUCKET=your-bucket-name
# NEXT_PUBLIC_S3_REGION=your-region
# NEXT_PUBLIC_S3_ACCESS_KEY=your-access-key
# NEXT_PUBLIC_S3_SECRET_KEY=your-secret-key

# Яндекс Метрика: номер счётчика. Пусто — счётчика и баннера о cookies нет
# NEXT_PUBLIC_YM_ID=12345678
