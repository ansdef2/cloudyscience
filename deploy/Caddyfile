# Caddy сам получает и продлевает сертификат Let's Encrypt для {$DOMAIN}.
# Требуется: домен указывает A-записью на IP сервера, порты 80 и 443 открыты.

{$DOMAIN} {
	encode gzip

	# API уходит на бэкенд, всё остальное — на Next.js
	handle /api/* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}
}
