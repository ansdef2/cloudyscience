# Скопируйте в deploy/.env и заполните: cp deploy/.env.example deploy/.env

# Домен, который A-записью указывает на IP сервера.
# На него Caddy выпустит сертификат Let's Encrypt.
DOMAIN=example.ru

# ---- Управляемая БД PostgreSQL из панели Timeweb ----
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
# false — если корневой сертификат провайдера не установлен в системе
DB_SSL_REJECT_UNAUTHORIZED=false

# ---- Авторизация ----
# Сгенерируйте свой: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
