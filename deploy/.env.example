# Скопируйте в deploy/.env и заполните: cp deploy/.env.example deploy/.env

# Адрес сайта для Caddy.
#   обычный режим:  DOMAIN=example.ru   — выпустит сертификат Let's Encrypt
#   запасной режим: DOMAIN=:80          — отдаст по IP без HTTPS, если DNS ещё не разошёлся
DOMAIN=example.ru

# Внешний адрес, по которому приложение открывают в браузере.
# Из него собирается URL API для фронтенда и разрешённый Origin для CORS.
#   обычный режим:  PUBLIC_URL=https://example.ru
#   запасной режим: PUBLIC_URL=http://IP-СЕРВЕРА
PUBLIC_URL=https://example.ru

# ---- Управляемая БД PostgreSQL из панели Timeweb ----
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true

# Строгая проверка сертификата (рекомендуется). Скачайте корневой сертификат
# провайдера в deploy/certs/root.crt — как именно, написано в DEPLOY_TIMEWEB.md.
# Путь указывается внутри контейнера, каталог deploy/certs смонтирован в /certs.
DB_SSL_CA=/certs/root.crt

# Учитывается, только если DB_SSL_CA пуст: шифровать, но сертификат не проверять
DB_SSL_REJECT_UNAUTHORIZED=false

# ---- Авторизация ----
# Сгенерируйте свой: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
