# Локальный запуск бэкенда: cp .env.example .env
# В Docker эти переменные приходят из docker-compose, файл там не нужен.

# ---- Подключение к PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudco
DB_USER=postgres
DB_PASSWORD=postgres

# ---- Сервер ----
PORT=3001
NODE_ENV=development

# Разрешённый Origin для CORS; * или пусто — разрешить всем
CORS_ORIGIN=http://localhost:3000

# false отключает автосинхронизацию схемы при старте
DB_SYNC=true

# ---- Авторизация ----
JWT_SECRET=cloudco-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# IoT: как часто опрашивать включённые каналы Zenoh, в секундах.
# Не задано или 0 — опроса нет (OctoEverywhere присылает данные вебхуком сам)
# IOT_POLL_INTERVAL_SEC=30

# ---- Почта (необязательно) ----
# Без SMTP_HOST письма не уходят — только пишутся в лог
# PUBLIC_URL=http://localhost:3000
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ADMIN_NOTIFY_EMAIL=

# Загруженные файлы; по умолчанию ./uploads
# UPLOAD_DIR=./uploads

# Демо-посты и эксперты в сиде (вне production включены по умолчанию)
# SEED_DEMO=true
